---
import { cachedAmazonImage, cachedAmazonPrice } from '@/lib/amazon-products';

interface Props {
  nombre: string;
  descripcion: string;
  precio: string;
  precioAmazon?: string;
  precioTiendanimal?: string;
  enlaceAmazon?: string;
  enlaceTiendanimal?: string;
  imagen?: string;
  etiqueta?: string;
}

const {
  nombre,
  descripcion,
  precio,
  precioAmazon,
  enlaceAmazon,
  imagen,
  etiqueta = 'Nuestra elección',
} = Astro.props;

/** Resize Amazon product images to save bandwidth (160px display × 2x retina = 320px) */
const optimizeImg = (url?: string) =>
  url?.replace(/\._AC_SL\d+_/, '._AC_SL320_') ?? url;

const amazonPrice = cachedAmazonPrice(enlaceAmazon);
const displayPrice = amazonPrice || precioAmazon || precio;
const imagenOpt = optimizeImg(cachedAmazonImage(enlaceAmazon) || imagen);
---

<div class="top-pick">
  <div class="top-pick-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true" style="vertical-align: -2px; margin-right: 4px;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> {etiqueta}</div>
  <div class="top-pick-body">
    {imagen && (
      <div class="top-pick-img-wrap">
        <img src={imagenOpt} alt={nombre} width="160" height="160" class="top-pick-img" loading="lazy" decoding="async" sizes="(max-width: 540px) 160px, 140px" />
      </div>
    )}
    <div class="top-pick-info">
      <p class="top-pick-nombre">{nombre}</p>
      <p class="top-pick-desc">{descripcion}</p>
      <p class="top-pick-precio">{displayPrice}</p>
    </div>
  </div>
</div>

<style>
.top-pick {
  background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 5%, var(--color-bg-card)) 0%, color-mix(in srgb, var(--color-primary) 10%, var(--color-bg-card)) 100%);
  border: 2px solid var(--color-primary);
  border-radius: var(--radius-xl);
  padding: 1.75rem 1.5rem 1.5rem;
  margin: 1.5rem 0;
  position: relative;
  box-shadow: 0 4px 24px color-mix(in srgb, var(--color-primary) 10%, transparent);
  transition: box-shadow 300ms cubic-bezier(0.23, 1, 0.32, 1);
}

.top-pick:hover {
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1), 0 4px 8px rgba(0, 0, 0, 0.06);
}

.top-pick-badge {
  position: absolute;
  top: -0.8rem;
  left: 1.25rem;
  background: var(--color-primary);
  color: #fff;
  padding: 0.3rem 0.75rem;
  border-radius: 100px;
  font-size: 0.7rem;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.top-pick-body {
  display: flex;
  gap: 1.5rem;
  align-items: flex-start;
  margin-top: 0.25rem;
}

.top-pick-img-wrap {
  flex-shrink: 0;
  background: var(--color-bg-muted);
  border-radius: var(--radius-md);
  padding: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-pick-img {
  width: 140px;
  height: 140px;
  object-fit: contain;
  transition: transform 300ms cubic-bezier(0.23, 1, 0.32, 1);
}

.top-pick:hover .top-pick-img {
  transform: scale(1.03);
}

.top-pick-info {
  flex: 1;
  min-width: 0;
}

.top-pick-nombre {
  font-size: 1.2rem;
  font-weight: 800;
  margin: 0 0 0.4rem;
  color: var(--color-text);
  letter-spacing: -0.02em;
}

.top-pick-desc {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  margin: 0 0 0.6rem;
  line-height: 1.5;
}

.top-pick-precio {
  font-size: 1.6rem;
  font-weight: 800;
  margin: 0 0 1rem;
  color: var(--color-primary);
  letter-spacing: -0.02em;
}

@media (max-width: 540px) {
  .top-pick {
    padding: 1.5rem 1.25rem 1.25rem;
  }

  .top-pick-body {
    flex-direction: column;
    align-items: flex-start;
  }

  .top-pick-img {
    width: 120px;
    height: 120px;
  }

  .top-pick-desc {
    text-align: left;
  }

  .top-pick-precio {
    font-size: 1.4rem;
  }

}
</style>
