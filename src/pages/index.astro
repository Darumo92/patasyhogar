---
import Base from '@/layouts/Base.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import IconCategory from '@/components/IconCategory.astro';
import QuizHomeBanner from '@/components/QuizHomeBanner.astro';
import { getCollection } from 'astro:content';

const articulos = await getCollection('articulos');

// Featured article (most recent with destacado: true)
const featuredArticle = articulos
  .filter(a => a.data.destacado)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())[0];

// Split by tipo
const comparativas = articulos
  .filter(a => a.data.tipo !== 'informativo')
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

const informativos = articulos
  .filter(a => a.data.tipo === 'informativo')
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

// Category counts (comparativas only)
const catCounts: Record<string, number> = {};
for (const a of articulos) {
  if (a.data.tipo !== 'informativo') {
    catCounts[a.data.categoria] = (catCounts[a.data.categoria] || 0) + 1;
  }
}

const categorias = [
  { slug: 'alimentacion', nombre: 'Alimentación' },
  { slug: 'higiene',      nombre: 'Higiene' },
  { slug: 'paseo',        nombre: 'Paseo' },
  { slug: 'juguetes',     nombre: 'Juguetes' },
  { slug: 'hogar',        nombre: 'Hogar' },
];

const guiasEsenciales = [
  {
    href: '/cuidados/guia-alimentacion-perros/',
    titulo: 'Alimentación para perros',
    descripcion: 'Pienso, raciones, comida húmeda y criterios para elegir según edad, tamaño y salud.',
    animal: 'Perros',
  },
  {
    href: '/cuidados/guia-completa-alimentacion-gatos/',
    titulo: 'Alimentación para gatos',
    descripcion: 'Bases de nutrición felina, hidratación, pienso, húmeda y errores habituales.',
    animal: 'Gatos',
  },
  {
    href: '/cuidados/guia-completa-higiene-grooming-perros/',
    titulo: 'Higiene del perro',
    descripcion: 'Baño, cepillado, oídos, uñas, dientes y antiparasitarios en una rutina realista.',
    animal: 'Perros',
  },
  {
    href: '/cuidados/guia-completa-higiene-cuidado-gatos/',
    titulo: 'Higiene del gato',
    descripcion: 'Arena, areneros, cepillado, uñas, bolas de pelo y limpieza sin estrés.',
    animal: 'Gatos',
  },
  {
    href: '/cuidados/guia-completa-salud-bienestar-perros/',
    titulo: 'Salud y bienestar canino',
    descripcion: 'Señales de alerta, prevención, ejercicio, peso y cuidados diarios.',
    animal: 'Perros',
  },
  {
    href: '/cuidados/guia-completa-salud-bienestar-gatos/',
    titulo: 'Salud y bienestar felino',
    descripcion: 'Cambios de conducta, prevención, estrés, alimentación y visitas al veterinario.',
    animal: 'Gatos',
  },
];

const productCollections = await getCollection('productos');
const totalProducts = productCollections.reduce((sum, c) => sum + c.data.length, 0);

const siteUrl = 'https://patasyhogar.com';

const recientes = comparativas.slice(0, 6);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Patas y Hogar',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/favicon-512.png`,
    width: 512,
    height: 512,
  },
  image: `${siteUrl}/favicon-512.png`,
  description: 'Guías de compra y comparativas de productos para perros y gatos',
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'contacto@patasyhogar.com',
    contactType: 'customer service',
    availableLanguage: 'es',
    areaServed: 'ES',
  },
  founder: {
    '@type': 'Person',
    name: 'Daniel Ruiz',
    url: `${siteUrl}/sobre-mi/`,
  },
  foundingDate: '2026',
  areaServed: 'ES',
  availableLanguage: 'es',
  sameAs: [
    'https://www.pinterest.com/patasyhogar/',
  ],
  knowsAbout: [
    'productos para perros',
    'productos para gatos',
    'alimentación de mascotas',
    'higiene y cuidado de mascotas',
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Últimos análisis de productos para mascotas',
  numberOfItems: recientes.length,
  itemListElement: recientes.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteUrl}/${a.data.categoria}/${a.slug}/`,
    name: a.data.titulo,
  })),
};

function articleUrl(a: typeof articulos[0]) {
  return a.data.tipo === 'informativo'
    ? `/cuidados/${a.slug}/`
    : `/${a.data.categoria}/${a.slug}/`;
}
---

<Base
  title="Patas y Hogar · Guías y comparativas para perros y gatos"
  description="Análisis honestos y comparativas de productos para perros y gatos. Pienso, accesorios, higiene, camas y transportines. Todo lo que tu mascota necesita."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} slot="head" />

  <!-- 1. Hero -->
  <section class="hero">
    <div class="container">
      <p class="hero-label">Guías y comparativas para mascotas</p>
      <h1 class="hero-title">Lo mejor para tu perro y tu gato</h1>
      <p class="hero-subtitle">Analizamos productos en Amazon, Zooplus y Tiendanimal para que tú solo tengas que elegir.</p>
      <div class="hero-ctas">
        <a href="/perros/" class="hero-cta dog"><IconCategory category="perro" size={18} /> Guías para perros</a>
        <a href="/gatos/" class="hero-cta cat"><IconCategory category="gato" size={18} /> Guías para gatos</a>
      </div>
    </div>
  </section>

  <!-- 2. Featured Article -->
  {featuredArticle && (
    <section class="featured">
      <div class="container">
        <a href={articleUrl(featuredArticle)} class="featured-card">
          <div class="featured-img">
            {featuredArticle.data.imagen ? (
              <img
                src={featuredArticle.data.imagen}
                alt={featuredArticle.data.imagenAlt || featuredArticle.data.titulo}
                width="800"
                height="500"
                loading="eager"
                fetchpriority="high"
              />
            ) : (
              <div class="featured-placeholder"></div>
            )}
          </div>
          <div class="featured-body">
            <span class="featured-badge">Artículo destacado</span>
            <h2>{featuredArticle.data.titulo}</h2>
            <p>{featuredArticle.data.descripcion}</p>
            <span class="featured-link">Leer artículo →</span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- 3. Categories -->
  <section class="categories">
    <div class="container">
      <div class="section-header">
        <h2>Categorías</h2>
        <a href="/articulos/">Ver todo →</a>
      </div>
      <div class="categories-grid">
        {categorias.map(cat => (
          <a href={`/${cat.slug}/`} class="cat-card">
            <div class="cat-icon"><IconCategory category={cat.slug} size={28} /></div>
            <h3>{cat.nombre}</h3>
            <span>{catCounts[cat.slug] || 0} guías</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Essential Guides -->
  <section class="essential-guides">
    <div class="container">
      <div class="section-header">
        <h2>Guías esenciales</h2>
        <a href="/cuidados/">Ver cuidados →</a>
      </div>
      <div class="essential-guides-grid">
        {guiasEsenciales.map(guia => (
          <a href={guia.href} class="essential-guide-card">
            <span class="essential-guide-animal">{guia.animal}</span>
            <h3>{guia.titulo}</h3>
            <p>{guia.descripcion}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Quiz CTA Banner — after categories, before articles */}
  {totalProducts > 0 && (
    <QuizHomeBanner totalProducts={totalProducts} totalCategories={5} />
  )}

  <!-- 5. Latest Comparativas -->
  {recientes.length > 0 && (
    <section class="articles">
      <div class="container">
        <div class="section-header">
          <h2>Últimas comparativas</h2>
          <a href="/articulos/">Ver todas →</a>
        </div>
        <div class="articles-grid">
          {recientes.map((articulo, i) => (
            <ArticleCard articulo={articulo} headingLevel={3} eager={i < 2} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 6. Guides (Informativos) -->
  {informativos.length > 0 && (
    <section class="guides">
      <div class="container">
        <div class="section-header">
          <h2>Guías de cuidados</h2>
          <a href="/cuidados/">Ver todas →</a>
        </div>
        <div class="guides-grid">
          {informativos.slice(0, 6).map(guide => (
            <a href={`/cuidados/${guide.slug}/`} class="guide-card">
              <div class="guide-icon">📖</div>
              <div class="guide-info">
                <h3>{guide.data.titulo}</h3>
                <span>{guide.data.animal === 'perro' ? 'Perros' : guide.data.animal === 'gato' ? 'Gatos' : 'Perros y gatos'}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 7. Newsletter -->
  <section class="container">
    <div class="newsletter">
      <h2>No te pierdas nada</h2>
      <p>Recibe las últimas guías y ofertas en tu email. Sin spam, solo contenido útil.</p>
      <form class="newsletter-form" id="newsletter-form">
        <input type="email" name="email" placeholder="tu@email.com" required aria-label="Tu email" />
        <button type="submit">Suscribirme</button>
      </form>
      <p class="newsletter-msg" id="newsletter-msg" style="margin-top:0.75rem;font-size:0.8rem;display:none;"></p>
    </div>
  </section>

  <script is:inline>
  (function(){
    var f=document.getElementById('newsletter-form');
    var m=document.getElementById('newsletter-msg');
    if(!f||!m)return;
    f.addEventListener('submit',function(e){
      e.preventDefault();
      var email=f.querySelector('input[name="email"]').value;
      if(!email)return;
      var btn=f.querySelector('button');
      btn.disabled=true;btn.textContent='Enviando...';
      fetch('/api/subscribe',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({email:email})
      }).then(function(r){
        if(r.ok){
          m.style.display='block';m.style.color='var(--green-600)';
          m.textContent='¡Suscripción confirmada! Revisa tu email.';
          f.reset();
        }else{
          throw new Error('Error');
        }
      }).catch(function(){
        m.style.display='block';m.style.color='var(--color-text-muted)';
        m.textContent='Hubo un error. Inténtalo de nuevo.';
      }).finally(function(){
        btn.disabled=false;btn.textContent='Suscribirme';
      });
    });
  })();
  </script>

  <style>
    .essential-guides {
      padding: 3rem 0;
      background: var(--color-bg-muted);
    }
    .essential-guides-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    .essential-guide-card {
      display: block;
      padding: 1.25rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-bg-card);
      text-decoration: none;
      color: var(--color-text);
      transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
    }
    .essential-guide-card:hover {
      border-color: var(--color-primary);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }
    .essential-guide-animal {
      display: inline-flex;
      margin-bottom: 0.65rem;
      padding: 0.15rem 0.5rem;
      border-radius: var(--radius-pill);
      background: var(--green-100);
      color: var(--color-primary-dark);
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }
    .essential-guide-card h3 {
      margin-bottom: 0.45rem;
      font-size: 1rem;
    }
    .essential-guide-card p {
      margin: 0;
      color: var(--color-text-muted);
      font-size: 0.9rem;
      line-height: 1.55;
    }
    @media (max-width: 900px) {
      .essential-guides-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 560px) {
      .essential-guides-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
